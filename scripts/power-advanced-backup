#!/bin/bash
#
# Copies this plugin's config and the drop-ins it installed into a state
# directory, so a bad ruleset can be undone. Not wired to the panel; run by
# hand before experimenting.
set -euo pipefail

# shellcheck source=lib.sh
. "$(dirname "$(realpath "$0")")/lib.sh"

pa_require jq

# Under sudo, $HOME is root's -- the backup belongs to the invoking user.
STATE_HOME=${XDG_STATE_HOME:-${HOME:-}/.local/state}
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
  USER_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)
  [ -n "$USER_HOME" ] && STATE_HOME="$USER_HOME/.local/state"
fi
BACKUP_DIR="$STATE_HOME/omarchy/power-advanced/backup"

mkdir -p "$BACKUP_DIR" || pa_fail "cannot create $BACKUP_DIR"

SAVED=()
save() {
  local src=$1 dest=$2
  [ -f "$src" ] || return 0
  cp "$src" "$BACKUP_DIR/$dest" || { pa_log "could not back up $src"; return 0; }
  SAVED+=("$dest")
}

save "/etc/systemd/logind.conf.d/$PA_UNIT.conf" "logind-$PA_UNIT.conf"
save "/etc/systemd/sleep.conf.d/$PA_UNIT.conf"  "sleep-$PA_UNIT.conf"
save "/etc/udev/rules.d/$PA_UNIT.rules"         "$PA_UNIT.rules"
save "/etc/tmpfiles.d/$PA_UNIT-limit.conf"      "$PA_UNIT-limit.conf"

if CONFIG_FILE=$(pa_resolve_config "${OMARCHY_POWER_CONF:-}"); then
  save "$CONFIG_FILE" "user-config.json"
fi

# The files were created by root; hand them back to whoever asked.
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
  chown -R "$SUDO_USER" "$BACKUP_DIR" || pa_log "could not chown $BACKUP_DIR"
fi

pa_ok "$(jq -cn --arg dir "$BACKUP_DIR" --argjson saved "$(printf '%s\n' "${SAVED[@]+"${SAVED[@]}"}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
  '{backup_dir: $dir, saved: $saved}')"
