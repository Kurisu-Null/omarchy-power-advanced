#!/bin/bash
set -euo pipefail
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# 1. Resolve Config File
CONFIG_FILE="${OMARCHY_POWER_CONF:-${1:-}}"
if [ -z "$CONFIG_FILE" ]; then
    CANDIDATES=()
    # Current name first in every location, then the upstream name this plugin
    # was forked from, so an existing onlyvishesh config keeps working.
    for conf_name in kurisu-null.power-advanced.json onlyvishesh.power-manager.json; do
        if [ -n "${XDG_CONFIG_HOME:-}" ]; then CANDIDATES+=("$XDG_CONFIG_HOME/$conf_name"); fi
        if [ -n "${HOME:-}" ]; then CANDIDATES+=("$HOME/.config/$conf_name"); fi
        for u_home in /home/*; do
            if [ -d "$u_home/.config" ]; then CANDIDATES+=("$u_home/.config/$conf_name"); fi
        done
    done
    for cand in "${CANDIDATES[@]}"; do
        if [ -f "$cand" ]; then CONFIG_FILE="$cand"; break; fi
    done
fi

PREV="none"
if command -v powerprofilesctl >/dev/null 2>&1; then PREV=$(powerprofilesctl get 2>/dev/null || echo "none"); fi
NEW_PROF="balanced"; REASON="default"

PSY_PATH="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"
AC_ONLINE=false
if [ -d "$PSY_PATH" ]; then
    for supply in "$PSY_PATH"/*; do
        [ -d "$supply" ] || continue
        type=$(cat "$supply/type" 2>/dev/null || true)
        if [[ "$type" =~ ^(Mains|USB|USB_PD|USB_C)$ ]]; then
            if [ "$(cat "$supply/online" 2>/dev/null | tr -d '[:space:]')" = "1" ]; then
                AC_ONLINE=true; break
            fi
        fi
    done
fi

BAT_COUNT=0; BAT_CAP_SUM=0; BAT_PRESENT=false
if [ -d "$PSY_PATH" ]; then
    for supply in "$PSY_PATH"/*; do
        [ -d "$supply" ] || continue
        is_bat=false
        type=$(cat "$supply/type" 2>/dev/null || true)
        if [ "$type" = "Battery" ] || [[ "$(basename "$supply")" =~ ^BAT[0-9]+ ]]; then is_bat=true; fi
        if [ "$is_bat" = "true" ]; then
            BAT_PRESENT=true
            if [ -r "$supply/capacity" ]; then
                cap=$(cat "$supply/capacity" 2>/dev/null | tr -d '[:space:]' || echo "")
                if [[ "$cap" =~ ^[0-9]+$ ]]; then
                    BAT_CAP_SUM=$((BAT_CAP_SUM + cap)); BAT_COUNT=$((BAT_COUNT + 1))
                fi
            fi
        fi
    done
fi
BAT_CAP=$(( BAT_COUNT > 0 ? BAT_CAP_SUM / BAT_COUNT : 100 ))

ENABLED="true"
PROF_AC="performance"; PROF_BAT_HIGH="balanced"; PROF_BAT_LOW="power-saver"; BAT_THRESH=30
BRIGHT_AUTO="false"; BRIGHT_AC=80; BRIGHT_BAT_HIGH=50; BRIGHT_BAT_LOW=20

if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ] && jq empty "$CONFIG_FILE" 2>/dev/null; then
    ENABLED=$(jq -r 'if has("enabled") and .enabled == false then "false" else "true" end' "$CONFIG_FILE" 2>/dev/null || echo "true")
    PROF_AC=$(jq -r '(.profiles?.ac // "performance")' "$CONFIG_FILE" 2>/dev/null || echo "performance")
    PROF_BAT_HIGH=$(jq -r '(.profiles?.batteryHigh // "balanced")' "$CONFIG_FILE" 2>/dev/null || echo "balanced")
    PROF_BAT_LOW=$(jq -r '(.profiles?.batteryLow // "power-saver")' "$CONFIG_FILE" 2>/dev/null || echo "power-saver")
    BAT_THRESH=$(jq -r '(.batteryThreshold // 30)' "$CONFIG_FILE" 2>/dev/null || echo "30")
    
    BRIGHT_AUTO=$(jq -r 'if .brightness?.auto == true then "true" else "false" end' "$CONFIG_FILE" 2>/dev/null || echo "false")
    BRIGHT_AC=$(jq -r '(.brightness?.ac // 80)' "$CONFIG_FILE" 2>/dev/null || echo "80")
    BRIGHT_BAT_HIGH=$(jq -r '(.brightness?.batteryHigh // 50)' "$CONFIG_FILE" 2>/dev/null || echo "50")
    BRIGHT_BAT_LOW=$(jq -r '(.brightness?.batteryLow // 20)' "$CONFIG_FILE" 2>/dev/null || echo "20")
fi
if ! [[ "$BAT_THRESH" =~ ^[0-9]+$ ]]; then BAT_THRESH=30; fi

NEW_BRIGHT=""; STATE_KEY="ac"
if [ "$ENABLED" = "false" ]; then
    NEW_PROF="$PREV"; REASON="disabled"; STATE_KEY="ac"
else
    if [ "$AC_ONLINE" = "true" ] || [ "$BAT_PRESENT" = "false" ]; then
        NEW_PROF="$PROF_AC"; REASON="ac_connected"; NEW_BRIGHT="$BRIGHT_AC"; STATE_KEY="ac"
    else
        if [ "$BAT_CAP" -le "$BAT_THRESH" ]; then
            NEW_PROF="$PROF_BAT_LOW"; REASON="low_battery"; NEW_BRIGHT="$BRIGHT_BAT_LOW"; STATE_KEY="batteryLow"
        else
            NEW_PROF="$PROF_BAT_HIGH"; REASON="battery"; NEW_BRIGHT="$BRIGHT_BAT_HIGH"; STATE_KEY="batteryHigh"
        fi
    fi
fi
if [ -z "$NEW_PROF" ] || [ "$NEW_PROF" = "null" ]; then NEW_PROF="balanced"; fi

if [ "$ENABLED" = "true" ]; then
    # PROFILE SWITCH
    if [ "$NEW_PROF" != "none" ]; then
        if command -v powerprofilesctl >/dev/null 2>&1; then
            powerprofilesctl set "$NEW_PROF" 2>/dev/null || true
        elif command -v omarchy-powerprofiles-set >/dev/null 2>&1; then
            omarchy-powerprofiles-set autodetect "$NEW_PROF" 2>/dev/null || true
        fi
        
        STATE_DIRS=()
        if [ -n "${XDG_STATE_HOME:-}" ]; then STATE_DIRS+=("$XDG_STATE_HOME/omarchy/powerprofiles"); fi
        if [ -n "${HOME:-}" ]; then STATE_DIRS+=("$HOME/.local/state/omarchy/powerprofiles"); fi
        for u_home in /home/*; do
            if [ -d "$u_home" ]; then STATE_DIRS+=("$u_home/.local/state/omarchy/powerprofiles"); fi
        done
        for sdir in "${STATE_DIRS[@]}"; do
            mkdir -p "$sdir" 2>/dev/null || true
            if [ "$AC_ONLINE" = "true" ] || [ "$BAT_PRESENT" = "false" ]; then
                echo "$PROF_AC" > "$sdir/ac" 2>/dev/null || true
                if [ ! -f "$sdir/battery" ]; then echo "$PROF_BAT_HIGH" > "$sdir/battery" 2>/dev/null || true; fi
            else
                echo "$NEW_PROF" > "$sdir/battery" 2>/dev/null || true
                if [ ! -f "$sdir/ac" ]; then echo "$PROF_AC" > "$sdir/ac" 2>/dev/null || true; fi
            fi
        done
    fi

    # BRIGHTNESS SWITCH
    if [ "$BRIGHT_AUTO" = "true" ] && [ -n "$NEW_BRIGHT" ] && [ "$NEW_BRIGHT" != "0" ] && [ "$NEW_BRIGHT" != "0%" ]; then
        if ! [[ "$NEW_BRIGHT" =~ %$ ]]; then NEW_BRIGHT="${NEW_BRIGHT}%"; fi
        if [ "$(id -u)" -eq 0 ]; then
            if command -v brightnessctl >/dev/null 2>&1; then
                brightnessctl set "$NEW_BRIGHT" >/dev/null 2>&1 || true
            fi
        else
            if command -v omarchy-brightness-display >/dev/null 2>&1; then
                omarchy-brightness-display --no-osd "$NEW_BRIGHT" >/dev/null 2>&1 || true
            elif command -v brightnessctl >/dev/null 2>&1; then
                brightnessctl set "$NEW_BRIGHT" >/dev/null 2>&1 || true
            fi
        fi
    fi
    
    # DYNAMIC LOGIND CONFIGURATION
    if [ "$(id -u)" -eq 0 ] || [ -n "${OMARCHY_SYSTEMD_LOGIND_DIR:-}" ] || [ -n "${OMARCHY_SYSTEMD_SLEEP_DIR:-}" ]; then
        # Parse configs
        
        HIB_AC_MINS=$(jq -r '.idle?.ac?.hibernateAfterMinutes // 15' "$CONFIG_FILE" 2>/dev/null || echo 15)
        HIB_BAT_MINS=$(jq -r '.idle?.batteryHigh?.hibernateAfterMinutes // .idle?.batteryLow?.hibernateAfterMinutes // 15' "$CONFIG_FILE" 2>/dev/null || echo 15)
        HIB_MINS=$HIB_AC_MINS
        if [ "$HIB_BAT_MINS" -gt 0 ] && [ "$HIB_BAT_MINS" -lt "$HIB_AC_MINS" ]; then HIB_MINS=$HIB_BAT_MINS; fi
        
        LID_IGN=$(jq -r 'if .lid?.ignoreLidClose == true then "true" else "false" end' "$CONFIG_FILE" 2>/dev/null || echo "false")
        LID_AC_ACT=$(jq -r '.lid?.ac?.action // "suspend"' "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        if [ "$STATE_KEY" = "batteryLow" ]; then
            LID_BAT_ACT=$(jq -r '.lid?.batteryLow?.action // .lid?.battery?.action // "suspend"' "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        else
            LID_BAT_ACT=$(jq -r '.lid?.batteryHigh?.action // .lid?.battery?.action // "suspend"' "$CONFIG_FILE" 2>/dev/null || echo "suspend")
        fi
        
        if [ "$LID_IGN" = "true" ]; then
            LID_AC_ACT="ignore"
            LID_BAT_ACT="ignore"
        fi
        
        HIB_SEC=$((HIB_MINS * 60))
        
        LOGIND_DIR="${OMARCHY_SYSTEMD_LOGIND_DIR:-/etc/systemd/logind.conf.d}"
        SLEEP_DIR="${OMARCHY_SYSTEMD_SLEEP_DIR:-/etc/systemd/sleep.conf.d}"
        mkdir -p "$LOGIND_DIR" "$SLEEP_DIR" 2>/dev/null || true
        
        # Lid handling only. IdleAction/IdleActionSec are deliberately not
        # written: logind decides a session is idle from IdleHint, which nothing
        # sets under Hyprland, so they would never fire. Idle sleep is handled in
        # the panel by Wayland's idle-notify protocol instead. Lid events do not
        # go through IdleHint, so these lines are the real mechanism.
        cat <<INI > "$LOGIND_DIR/90-power-advanced.conf"
[Login]
HandleLidSwitch=$LID_BAT_ACT
HandleLidSwitchExternalPower=$LID_AC_ACT
HandleLidSwitchDocked=ignore
INI
        
        cat <<INI > "$SLEEP_DIR/90-power-advanced.conf"
[Sleep]
HibernateDelaySec=$HIB_SEC
SuspendEstimationSec=3600
INI
        
        
    # Omarchy's screensaver and lock timers are deliberately left alone.
    #
    # Earlier versions rewrote ~/.config/omarchy/shell.json here to force
    # idle.lock to equal this plugin's sleep timeout, with the screensaver 30s
    # ahead of it. The intent was to lock before sleeping and to make the
    # panel's idle worker start counting in time. Both were wrong to do this
    # way: lock is a security policy and sleep is a power policy, so equating
    # them silently *lengthens* the lock timeout whenever the sleep timeout is
    # long (a 30 minute sleep rule pushed a 5 minute lock out to 30 minutes).
    # It also ran as root on every AC plug/unplug via the udev rule, so a
    # setting the user had chosen in Omarchy's own settings kept coming back
    # changed with no prompt.
    #
    # The idle worker does not need it: it computes its countdown as
    # sleepAfterMinutes*60 minus the time the shell has already been idle, so
    # it stays correct as long as the shell's screensaver fires before the
    # sleep timeout, and it clamps when it does not. Screensaver and lock
    # timing belong to Omarchy's idle settings.

        systemctl kill -s HUP systemd-logind 2>/dev/null || true
    fi
fi

echo "{\"previous\": \"$PREV\", \"current\": \"$NEW_PROF\", \"brightness\": \"$NEW_BRIGHT\", \"state\": \"$STATE_KEY\", \"reason\": \"$REASON\", \"success\": true}"
exit 0
