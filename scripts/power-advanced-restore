#!/bin/bash
#
# Puts back what power-advanced-backup saved. The drop-ins need root; the user
# config does not, so each half is restored independently.
set -euo pipefail

# shellcheck source=lib.sh
. "$(dirname "$(realpath "$0")")/lib.sh"

pa_require jq

STATE_HOME=${XDG_STATE_HOME:-${HOME:-}/.local/state}
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
  USER_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)
  [ -n "$USER_HOME" ] && STATE_HOME="$USER_HOME/.local/state"
fi
BACKUP_DIR="$STATE_HOME/omarchy/power-advanced/backup"

[ -d "$BACKUP_DIR" ] || pa_fail "no backup found at $BACKUP_DIR"

RESTORED=()
restore() {
  local src="$BACKUP_DIR/$1" dest_dir=$2 dest_name=$3
  [ -f "$src" ] || return 0
  mkdir -p "$dest_dir" || { pa_log "cannot create $dest_dir"; return 0; }
  cp "$src" "$dest_dir/$dest_name" || { pa_log "could not restore $dest_name"; return 0; }
  RESTORED+=("$dest_dir/$dest_name")
}

if [ "$(id -u)" -eq 0 ]; then
  restore "logind-$PA_UNIT.conf"   /etc/systemd/logind.conf.d "$PA_UNIT.conf"
  restore "sleep-$PA_UNIT.conf"    /etc/systemd/sleep.conf.d  "$PA_UNIT.conf"
  restore "$PA_UNIT.rules"         /etc/udev/rules.d          "$PA_UNIT.rules"
  restore "$PA_UNIT-limit.conf"    /etc/tmpfiles.d            "$PA_UNIT-limit.conf"

  command -v udevadm >/dev/null 2>&1 && { udevadm control --reload-rules || pa_log "udevadm reload failed"; }
  systemctl kill -s HUP systemd-logind || pa_log "could not signal systemd-logind"
else
  pa_log "not root: skipping the system drop-ins, restoring the user config only"
fi

if [ -f "$BACKUP_DIR/user-config.json" ]; then
  TARGET="${HOME:-}/.config/${PA_CONFIG_NAMES[0]}"
  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    USER_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)
    [ -n "$USER_HOME" ] && TARGET="$USER_HOME/.config/${PA_CONFIG_NAMES[0]}"
  fi
  if cp "$BACKUP_DIR/user-config.json" "$TARGET"; then
    [ -n "${SUDO_USER:-}" ] && chown "$SUDO_USER" "$TARGET" 2>/dev/null || true
    RESTORED+=("$TARGET")
  else
    pa_log "could not restore the user config to $TARGET"
  fi
fi

pa_ok "$(jq -cn --argjson restored "$(printf '%s\n' "${RESTORED[@]+"${RESTORED[@]}"}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
  '{restored: $restored}')"
