#!/bin/bash
set -euo pipefail

BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/power-manager/backup"
if [ -n "${SUDO_USER:-}" ] && [ "$(id -u)" -eq 0 ]; then
    U_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)
    if [ -n "$U_HOME" ]; then
        BACKUP_DIR="$U_HOME/.local/state/omarchy/power-manager/backup"
    fi
fi

mkdir -p "$BACKUP_DIR"

if [ -f "/etc/systemd/logind.conf.d/90-power-advanced.conf" ]; then
    cp "/etc/systemd/logind.conf.d/90-power-advanced.conf" "$BACKUP_DIR/logind-90-power-advanced.conf" 2>/dev/null || true
fi

if [ -f "/etc/systemd/sleep.conf.d/90-power-advanced.conf" ]; then
    cp "/etc/systemd/sleep.conf.d/90-power-advanced.conf" "$BACKUP_DIR/sleep-90-power-advanced.conf" 2>/dev/null || true
fi

if [ -f "/etc/udev/rules.d/90-power-advanced.rules" ]; then
    cp "/etc/udev/rules.d/90-power-advanced.rules" "$BACKUP_DIR/" 2>/dev/null || true
fi

CONFIG_FILE="${OMARCHY_POWER_CONF:-}"
if [ -z "$CONFIG_FILE" ]; then
    for cand in "${XDG_CONFIG_HOME:-$HOME/.config}/kurisu-null.power-advanced.json" "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/power-manager.json" "$HOME/.config/kurisu-null.power-advanced.json"; do
        if [ -f "$cand" ]; then CONFIG_FILE="$cand"; break; fi
    done
fi

if [ -n "$CONFIG_FILE" ] && [ -f "$CONFIG_FILE" ]; then
    cp "$CONFIG_FILE" "$BACKUP_DIR/user-config.json" 2>/dev/null || true
fi

if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    chown -R "$SUDO_USER" "$BACKUP_DIR" 2>/dev/null || true
fi

echo "{\"success\": true, \"backup_dir\": \"$BACKUP_DIR\"}"
