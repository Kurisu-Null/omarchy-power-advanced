#!/bin/bash
set -euo pipefail

BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/power-manager/backup"
if [ -n "${SUDO_USER:-}" ] && [ "$(id -u)" -eq 0 ]; then
    U_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)
    if [ -n "$U_HOME" ]; then
        BACKUP_DIR="$U_HOME/.local/state/omarchy/power-manager/backup"
    fi
fi

if [ ! -d "$BACKUP_DIR" ]; then
    echo "{\"success\": false, \"errors\": [\"Backup directory not found\"]}"
    exit 1
fi

if [ "$(id -u)" -eq 0 ]; then
    if [ -f "$BACKUP_DIR/logind-90-power-advanced.conf" ]; then
        mkdir -p /etc/systemd/logind.conf.d
        cp "$BACKUP_DIR/logind-90-power-advanced.conf" "/etc/systemd/logind.conf.d/90-power-advanced.conf" 2>/dev/null || true
    fi
    if [ -f "$BACKUP_DIR/sleep-90-power-advanced.conf" ]; then
        mkdir -p /etc/systemd/sleep.conf.d
        cp "$BACKUP_DIR/sleep-90-power-advanced.conf" "/etc/systemd/sleep.conf.d/90-power-advanced.conf" 2>/dev/null || true
    fi
    if [ -f "$BACKUP_DIR/90-power-advanced.rules" ]; then
        mkdir -p /etc/udev/rules.d
        cp "$BACKUP_DIR/90-power-advanced.rules" "/etc/udev/rules.d/" 2>/dev/null || true
    fi
    
    systemctl kill -s HUP systemd-logind 2>/dev/null || true
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
    fi
fi

CONFIG_FILE="${OMARCHY_POWER_CONF:-}"
if [ -z "$CONFIG_FILE" ]; then
    for cand in "${XDG_CONFIG_HOME:-$HOME/.config}/kurisu-null.power-advanced.json" "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/power-manager.json" "$HOME/.config/kurisu-null.power-advanced.json"; do
        if [ -f "$cand" ]; then CONFIG_FILE="$cand"; break; fi
    done
fi

if [ -n "$CONFIG_FILE" ] && [ -f "$BACKUP_DIR/user-config.json" ]; then
    if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
        cp "$BACKUP_DIR/user-config.json" "$CONFIG_FILE" 2>/dev/null || true
        chown "$SUDO_USER" "$CONFIG_FILE" 2>/dev/null || true
    else
        cp "$BACKUP_DIR/user-config.json" "$CONFIG_FILE" 2>/dev/null || true
    fi
fi

echo "{\"success\": true}"
